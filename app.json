{
  "expo": {
    "name": "Verve",
    "slug": "verve",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "verve",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0E14",
    "primaryColor": "#C2687A",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "az.verve.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "az",
          "ru",
          "en"
        ],
        "CFBundleDevelopmentRegion": "az"
      }
    },
    "android": {
      "package": "az.verve.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0E14"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0E14"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/verve"
    }
  }
}
