# ---------------------------------------------------------------------------
# Secrets & environment
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Anything that smells like a credential
*.pem
*.key
*.cer
*.der
*.pfx
secrets.json
credentials.json
service-account*.json

# ---------------------------------------------------------------------------
# Mobile signing material — NEVER commit these
# ---------------------------------------------------------------------------
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
google-services.json
GoogleService-Info.plist

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Expo / React Native
# ---------------------------------------------------------------------------
.expo/
.expo-shared/
dist/
build/
web-build/
expo-env.d.ts
*.tsbuildinfo

# Native projects are generated by `expo prebuild` — not source of truth
/ios/
/android/

# Native build artifacts (in case the dirs are ever checked in deliberately)
*.hprof
*.orig.*
*.jsbundle
*.apk
*.aab
*.ipa
*.app
*.xcworkspace
xcuserdata/
DerivedData/
Pods/

# Metro
.metro-health-check*
metro.config.js.bak

# ---------------------------------------------------------------------------
# Local data / databases
# ---------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
local.properties

# ---------------------------------------------------------------------------
# Logs, coverage, caches
# ---------------------------------------------------------------------------
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
logs/
coverage/
.nyc_output/
.cache/
.eslintcache

# ---------------------------------------------------------------------------
# Editors & OS
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---------------------------------------------------------------------------
# Video source files — I film these; they are large and stay out of git.
# Keep the README that lists expected filenames.
# ---------------------------------------------------------------------------
assets/videos/*
!assets/videos/README.md
!assets/videos/.gitkeep

# Expo Router generated types
.expo/types/
expo-env.d.ts
